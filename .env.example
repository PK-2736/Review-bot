# Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# Todoist API Token
TODOIST_API_TOKEN=your_todoist_api_token_here
TODOIST_API_BASE_URL=https://api.todoist.com/api/v1

# Review Settings
DEFAULT_PROJECT_NAME=復習タスク

# Notification Settings
TODO_NOTIFICATION_CHANNEL_ID=1468959638052540439

# Google Classroom Sync Settings
CLASSROOM_ENABLED=false
CLASSROOM_SYNC_TIME=0 7 * * *
CLASSROOM_DUE_WITHIN_DAYS=7
CLASSROOM_COURSE_IDS=
CLASSROOM_PROJECT_NAME=Classroom
CLASSROOM_TIMEZONE=Asia/Tokyo
CLASSROOM_AUTO_CLOSE=true

# Google OAuth (refresh token)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=

# Service Account (base64 or raw JSON)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_IMPERSONATE_USER=

# reMarkable レビュー
REMARKABLE_ENABLED=false
# 自動レビューの実行時刻（cron形式・既定は毎日23:00）
REMARKABLE_SYNC_TIME=0 23 * * *
REMARKABLE_TIMEZONE=Asia/Tokyo
# baseline / modified を保持する cache.json のパス（既定: src/data/cache.json）
REMARKABLE_CACHE_FILE=

# remarkable-mcp
# ※ 使用するツールは remarkable_browse と remarkable_page の2つのみ。
#    OCR は Gemini Vision が担当するため include_ocr=false で呼び出します。
#    REMARKABLE_MCP_TOKEN は、MCP サーバーがトークン認証を要求する場合のみ設定します。
REMARKABLE_MCP_URL=https://mcp.recrubo.net
REMARKABLE_MCP_TOKEN=

# Gemini Vision（OCR・要約・重要ポイント・TODO・タイトル生成）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
